# Trainer backend configuration (copy to .env and fill in)

DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=127.0.0.1,localhost

# MySQL (individual vars take priority; SSL is enabled automatically for non-local hosts)
DB_NAME=trainer_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
# DB_SSL=true
# DB_CONN_MAX_AGE=60

# Alternatively use a single URL (used only when DB_NAME is empty)
# DATABASE_URL=mysql://user:password@host:3306/dbname

# Shared secret used to sign/verify JWTs (must match the client gateway)
JWT_SECRET=change-me-to-a-long-random-secret
# Shared token the client gateway sends on internal calls
SERVICE_TOKEN=change-me-service-token

# Email (SMTP). Leave EMAIL_HOST empty to print emails to the console.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Trainer <noreply@example.com>

# CORS (when CORS_ALLOW_ALL_ORIGINS is false)
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=
# CORS_ALLOW_ALL_ORIGINS=true

# Deep links used in reset emails
TRAINER_APP_RESET_URL=trainer://auth/reset
CLIENT_APP_RESET_URL=trainerclient://auth/reset
